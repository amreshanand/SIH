# ============================================================
# UrbanSense AI — Environment Configuration
# Copy to .env and modify as needed
# ============================================================

# ---- General (REQUIRED) ----
PROJECT_NAME=UrbanSense AI
DEBUG=true
DEMO_MODE=false

# ---- Backend (REQUIRED) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
# REQUIRED: Generate a real secret key
# Run: openssl rand -hex 32
SECRET_KEY=GENERATE_WITH: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database (PostgreSQL + PostGIS) (REQUIRED) ----
DATABASE_URL=postgresql+asyncpg://urbansense:urbansense@localhost:5432/urbansense
DATABASE_URL_SYNC=postgresql://urbansense:urbansense@localhost:5432/urbansense

# ---- Edge AI (OPTIONAL) ----
EDGE_HOST=0.0.0.0
EDGE_PORT=8001
PHONE_STREAM_URL=http://192.168.1.100:8080/video
PHONE_GPS_URL=http://192.168.1.100:8080/gps
YOUTUBE_LIVE_URL=https://www.youtube.com/live/M4agAjfNayY?si=6s9V51z6poo8HrHI
# Per-camera video config surfaced to the Live Command Center (/live)
FRONT_CAMERA_ID=BUS-001-CAM-FRONT
FRONT_CAMERA_NAME=Front Road Camera
FRONT_CAMERA_TYPE=OUTSIDE
FRONT_STREAM_URL=https://www.youtube.com/live/M4agAjfNayY?si=6s9V51z6poo8HrHI
FRONT_SOURCE_MODE=LIVE
INSIDE_CAMERA_ID=BUS-001-CAM-INSIDE
INSIDE_CAMERA_NAME=Inside Cabin Camera
INSIDE_CAMERA_TYPE=INSIDE
INSIDE_STREAM_URL=https://youtu.be/T_4Vv5NGP0Y?si=4n3fWmHHX0r_DX0P
INSIDE_SOURCE_MODE=RECORDED_DEMO
YOUTUBE_REAR_URL=https://www.youtube.com/live/M4agAjfNayY?si=6s9V51z6poo8HrHI
YOUTUBE_LEFT_URL=https://www.youtube.com/live/M4agAjfNayY?si=6s9V51z6poo8HrHI
YOUTUBE_RIGHT_URL=https://www.youtube.com/live/M4agAjfNayY?si=6s9V51z6poo8HrHI
YOUTUBE_CABIN_URL=https://www.youtube.com/live/M4agAjfNayY?si=6s9V51z6poo8HrHI
VIDEO_SOURCE=phone
# Options: phone | webcam | file | rtsp | off
# If file: set VIDEO_FILE_PATH below
# If rtsp: set RTSP_FRONT_URL below
RTSP_FRONT_URL=

# ---- Multi-camera (Phase 3, optional) ----
# Front is always mandatory. Rear/left/right/cabin are optional and each maps
# to its own source type + URL so a bus can fuse up to 5 feeds.
MULTI_CAMERA_ENABLED=false
# CAM_FRONT_SOURCE=phone          # falls back to VIDEO_SOURCE when empty
# CAM_FRONT_URL=
# CAM_REAR_SOURCE=off             # off | phone | webcam | file | rtsp | youtube
# CAM_REAR_URL=rtsp://192.168.1.20:554/Streaming/Channels/102
# CAM_LEFT_SOURCE=off
# CAM_LEFT_URL=
# CAM_RIGHT_SOURCE=off
# CAM_RIGHT_URL=
# CAM_CABIN_SOURCE=off
# CAM_CABIN_URL=

VIDEO_FILE_PATH=data/videos/front.mp4
INFERENCE_FPS=10
# Batch multiple frames per inference forward pass on GPU.
INFERENCE_BATCH_SIZE=1
# Pre-exported engine to accelerate inference: "" | onnx | tensorrt | torchscript
INFERENCE_ENGINE_FORMAT=
FRAME_WIDTH=640
FRAME_HEIGHT=480

# ---- AI Models (REQUIRED for real inference) ----
# UrbanSense is a REAL-inference platform — there is no mock/simulated mode.
# Both models must exist on disk or the edge container fails fast.
YOLO_MODEL_PATH=models/yolov8n.pt
ROAD_DAMAGE_MODEL_PATH=models/road_damage.pt
CONFIDENCE_THRESHOLD=0.4
ROAD_DEFECT_CONFIDENCE_THRESHOLD=0.5

# ---- Spatial Engine (OPTIONAL) ----
# Options: auto | postgis | haversine
# auto = use PostGIS if available, else fallback to haversine
SPATIAL_ENGINE=auto

# ---- OCR (OPTIONAL; real backends only) ----
OCR_ENABLED=false
# Options: true | false
# Requires PaddleOCR or EasyOCR installed (edge/requirements-ml.txt)

OCR_PROVIDER=easyocr
# Options: paddle | easyocr | off
# There is no mock/placeholder OCR provider.

# ---- GPS (REAL sources; simulated is an explicit dev fallback) ----
GPS_MODE=phone
# Options: phone | nmea | simulated
# phone = receive GPS from Android phone app (real)
# nmea = NMEA-0183 serial/TCP GPS receiver (real)
# simulated = explicit dev/fallback route follower (labeled SIMULATED)

# Android phone GPS endpoint (gps_mode=phone)
# GPS_UPDATE_INTERVAL=1.0

# NMEA receiver settings (gps_mode=nmea)
GPS_NMEA_DEVICE=/dev/ttyUSB0
GPS_NMEA_BAUDRATE=9600
# For a networked NMEA feed use a host/port instead of a serial device:
# GPS_NMEA_HOST=
# GPS_NMEA_PORT=

# Set true to transparently fall back to the simulated route if the primary
# real GPS source is unavailable. Events are honestly labeled gps_source=SIMULATED.
GPS_ALLOW_SIMULATED_FALLBACK=true

GPS_SIMULATED_ROUTE=data/gps/pune_route.json
GPS_UPDATE_INTERVAL=1.0

# ---- Bus Configuration (OPTIONAL) ----
BUS_ID=BUS-001
CAMERA_POSITION=FRONT
# Options: FRONT | REAR | LEFT | RIGHT | CABIN

# ---- Streaming (OPTIONAL) ----
STREAM_WIDTH=640
STREAM_HEIGHT=360
STREAM_QUALITY=80
# JPEG quality for streaming (1-100)

# ---- Evidence (OPTIONAL) ----
EVIDENCE_DIR=data/evidence
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_ARCHIVE_ENABLED=true
EVIDENCE_ARCHIVE_DIR=data/evidence/archive
EVIDENCE_MAX_WIDTH=1280
EVIDENCE_THUMBNAIL_WIDTH=320

# ---- Event Engine (OPTIONAL) ----
EVENT_MIN_CONFIDENCE=0.5
EVENT_TEMPORAL_WINDOW=3.0
EVENT_MIN_OBSERVATIONS=2
# Cross-bus clustering radius (meters) used by the backend to merge nearby
# defects reported by multiple buses.
CLUSTER_DISTANCE_METERS=50

# ---- Spatial Clustering (OPTIONAL) ----
CLUSTER_DISTANCE_METERS=50
MIN_EVENTS_FOR_ISSUE=1
VERIFICATION_CLEAR_THRESHOLD=3

# ---- Notification (OPTIONAL) ----
NOTIFICATION_PROVIDER=inapp
# Options: inapp | email

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Frontend (OPTIONAL) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_DEMO_MODE=false

# ---- Map (OPTIONAL) ----
MAP_PROVIDER=leaflet
# Options: leaflet | mapbox
# Leaflet uses OpenStreetMap (no API key needed)

# ---- Docker (OPTIONAL) ----
POSTGRES_USER=urbansense
POSTGRES_PASSWORD=urbansense
POSTGRES_DB=urbansense
POSTGRES_PORT=5432
