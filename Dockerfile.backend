FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY edge/ ./edge/
COPY data/ ./data/

# Install entrypoint (runs migrations then starts the app).
COPY --chmod=0755 backend/docker-entrypoint.sh /app/backend/docker-entrypoint.sh

RUN useradd --create-home appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000 10000

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request, os; port=os.environ.get('PORT', '8000'); urllib.request.urlopen(f'http://localhost:{port}/health')" || exit 1

# docker-entrypoint.sh runs `alembic upgrade head` before starting the app.
CMD ["/app/backend/docker-entrypoint.sh"]
